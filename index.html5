const Coach={
  el:null,btn:null,face:null,badge:null,bub:null,
  last:0, idleT:0, restStart:0, hideT:null, dragging:false,
  init(){
    this.el=$('#buddy');this.btn=$('#buddyBtn');this.face=$('#buddyFace');this.badge=$('#buddyBadge');this.bub=$('#bubble');
    const p=S.settings.coach.pos||{x:innerWidth-84,y:innerHeight-190};
    this.move(p.x,p.y);
    this.anim('idle');
    if(S.settings.coach.hidden)this.el.style.display='none';
    /* drag */
    let sx,sy,ox,oy,moved=false,t0=0;
    const down=e=>{const pt=e.touches?e.touches[0]:e;sx=pt.clientX;sy=pt.clientY;
      ox=parseFloat(this.el.style.left);oy=parseFloat(this.el.style.top);moved=false;t0=Date.now();
      this.dragging=true;this.btn.style.cursor='grabbing';
      document.addEventListener('pointermove',mv);document.addEventListener('pointerup',up)};
    const mv=e=>{const pt=e;const dx=pt.clientX-sx,dy=pt.clientY-sy;
      if(Math.abs(dx)+Math.abs(dy)>8)moved=true;
      this.move(ox+dx,oy+dy)};
    const up=()=>{document.removeEventListener('pointermove',mv);document.removeEventListener('pointerup',up);
      this.btn.style.cursor='grab';this.dragging=false;
      const w=this.el.offsetWidth,x=parseFloat(this.el.style.left),y=parseFloat(this.el.style.top);
      const snapX=(x+w/2<innerWidth/2)?12:innerWidth-w-12;
      this.el.style.transition='left .25s cubic-bezier(.2,1.4,.4,1),top .25s';
      this.move(snapX,y); setTimeout(()=>this.el.style.transition='',260);
      S.settings.coach.pos={x:snapX,y};save();
      if(!moved&&Date.now()-t0<400)this.tap();};
    this.btn.addEventListener('pointerdown',down);
    /* ناظر وضعیت */
    setInterval(()=>this.watch(),5000);
    document.addEventListener('scroll',()=>{this.el.classList.add('mini');clearTimeout(this.hideT);
      this.hideT=setTimeout(()=>this.el.classList.remove('mini'),900)},{passive:true});
  },
  move(x,y){
    const w=this.el.offsetWidth||66,h=this.el.offsetHeight||66;
    x=Math.min(Math.max(6,x),innerWidth-w-6); y=Math.min(Math.max(70,y),innerHeight-h-80);
    this.el.style.left=x+'px';this.el.style.top=y+'px';
    const left=x<innerWidth/2;
    this.bub.style.top=(y-10)+'px';
    if(left){this.bub.style.left=(x+w+8)+'px';this.bub.style.right='auto'}
    else{this.bub.style.right=(innerWidth-x+8)+'px';this.bub.style.left='auto'}
  },
  anim(a,badge=''){
    this.btn.className='a-'+a;
    const F={idle:'🏋️‍♂️',lift:'🏋️‍♂️',cheer:'🤩',warn:'😤',sleep:'😴'};
    this.face.textContent=F[a]||'🏋️‍♂️'; this.badge.textContent=badge;
  },
  say(text,{anim='idle',badge='',dur=4800,sound=null,voice=true}={}){
    if(S.settings.coach.hidden)return;
    this.last=Date.now();
    this.bub.innerHTML=text;
    this.bub.classList.add('show');
    this.anim(anim,badge);
    if(sound)Snd.fire(sound);
    if(voice&&S.settings.coach.voice)Snd.speak(text);
    clearTimeout(this._t);
    this._t=setTimeout(()=>{this.bub.classList.remove('show');this.anim('idle')},dur);
  },
  pick(k){
    const p=S.settings.coach.persona;
    const bank=(MSG[p]&&MSG[p][k])||MSG.friendly[k]||['...'];
    return bank[Math.floor(Math.random()*bank.length)];
  },
  emit(ev,data={}){
    const chat=S.settings.coach.chatty;
    const cool={set:3000,idle:60000,water:1,open:1,restEnd:1,pr:1,finish:1,longRest:45000}[ev]??12000;
    if(Date.now()-this.last<cool && !['pr','finish','restEnd','open'].includes(ev))return;
    if(chat==='minimal'&&['set','idle','water','rest'].includes(ev))return;
    const M={
      open:   ()=>this.say(this.pick('open'),{anim:'cheer',badge:'👋',dur:5200}),
      start:  ()=>this.say(this.pick('start'),{anim:'lift',badge:'🔥',sound:'start'}),
      set:    ()=>this.say(this.pick('set')+(data.left?` <b class="text-pri">${fa(data.left)}</b> ست مونده`:''),{anim:'cheer',badge:'✅',sound:'set_done',dur:3200}),
      rest:   ()=>this.say(this.pick('rest')+` ⏱️ ${fa(data.sec||90)} ثانیه`,{anim:'idle',badge:'😮‍💨',dur:3500,voice:false}),
      restEnd:()=>this.say(this.pick('restEnd'),{anim:'warn',badge:'⏰',sound:'timer_end',dur:5000}),
      longRest:()=>this.say(this.pick('longRest'),{anim:'warn',badge:'⚠️',sound:'warn'}),
      pr:     ()=>{this.say(this.pick('pr')+` <b class="text-acc">${fa(data.w||'')}kg</b>`,{anim:'cheer',badge:'🏆',sound:'pr',dur:6000});confetti()},
      finish: ()=>{this.say(this.pick('finish'),{anim:'cheer',badge:'🎉',sound:'finish',dur:6500});confetti(90)},
      idle:   ()=>this.say(this.pick('idle'),{anim:'sleep',badge:'💤',dur:3200,voice:false}),
      water:  ()=>this.say(this.pick('water'),{anim:'idle',badge:'💧',dur:4000}),
      miss:   ()=>this.say(this.pick('miss'),{anim:'warn',badge:'😔',dur:5200}),
      rest_day:()=>this.say(this.pick('rest_day'),{anim:'sleep',badge:'🛌',dur:5000}),
    };
    (M[ev]||(()=>{}))();
  },
  tap(){
    if(Timer.running)return this.say(`⏱️ <b class="text-pri">${mmss(Timer.remain)}</b> مونده! تمرکز 💪`,{anim:'lift',dur:3000,voice:false});
    const tips=[
      `امروز روز <b class="text-pri">${fa(S.progress.days+1)}</b>ام توئه 🔥`,
      `🔥 <b class="text-acc">${fa(S.progress.streak)}</b> روز پشت‌سرهم! نذار قطع شه`,
      `💡 ${QUOTES[Math.floor(Math.random()*QUOTES.length)]}`,
      `⚡ سطح <b class="text-pri">${fa(S.progress.level)}</b> · ${fa(S.progress.xp)} XP`,
      `🎯 <b class="text-acc">${fa(Prog.next()-S.progress.days)}</b> روز تا نشان بعدی!`,
      `💧 یادت نره آب بخوری!`,
      `😴 خواب کافی = عضله‌سازی بیشتر`,
    ];
    this.say(tips[Math.floor(Math.random()*tips.length)],{anim:'cheer',badge:'💬',dur:5200,voice:false});
  },
  watch(){
    if(Timer.running&&Timer.mode==='rest'&&Timer.remain<=0){}
    if(Live.active){
      const idleMin=(Date.now()-Live.lastAct)/60000;
      if(idleMin>5&&idleMin<5.2)this.emit('longRest');
      if(idleMin>9&&idleMin<9.2)this.emit('idle');
      if(Live.started&&(Date.now()-Live.started)/60000>25&&!Live._water){Live._water=1;this.emit('water')}
    }
  }
};

/* ==========================================================================
   ۶) تایمر
   ========================================================================== */
const Timer={
  total:0,remain:0,running:false,endTs:0,tick:null,mode:'countdown',
  interval:null,round:0,phase:'work',wake:null,onEnd:null,
  set(sec){this.total=sec;this.remain=sec;this.mode='countdown';this.interval=null;this.render()},
  startCustom(sec,{label='تایمر',mode='countdown',onEnd=null}={}){
    this.label=label;this.mode=mode;this.onEnd=onEnd;this.set(sec);this.start();
  },
  startInterval(cfg){
    this.interval=cfg;this.round=1;this.phase='work';this.mode='interval';
    this.total=cfg.work;this.remain=cfg.work;this.start();
  },
  start(){
    if(this.remain<=0)return;
    Snd.unlock();
    this.running=true;this.endTs=Date.now()+this.remain*1000;
    clearInterval(this.tick);
    this._last=Math.ceil(this.remain);
    this.tick=setInterval(()=>this._t(),120);
    this.lock(); Snd.fire('start'); this.render();
  },
  pause(){this.running=false;clearInterval(this.tick);this.remain=Math.max(0,(this.endTs-Date.now())/1000);this.unlock();this.render()},
  toggle(){this.running?this.pause():this.start()},
  reset(){this.running=false;clearInterval(this.tick);this.remain=this.total;this.unlock();this.render()},
  add(s){this.remain=Math.max(0,this.remain+s);this.total=Math.max(this.total,this.remain);if(this.running)this.endTs=Date.now()+this.remain*1000;this.render()},
  _t(){
    this.remain=Math.max(0,(this.endTs-Date.now())/1000);
    const c=Math.ceil(this.remain);
    if(c!==this._last){
      this._last=c;
      if(c<=S.settings.timer.beepFrom&&c>0)Snd.fire('countdown');
    }
    if(this.remain<=0)this.done();
    this.render();
  },
  done(){
    clearInterval(this.tick);this.running=false;this.unlock();
    if(this.mode==='interval'&&this.interval){
      const cfg=this.interval;
      if(this.phase==='work'){ this.phase='rest';this.total=cfg.rest;this.remain=cfg.rest;Snd.fire('timer_end');
        Coach.say(`استراحت! دور <b>${fa(this.round)}</b> از ${fa(cfg.rounds)} 😮‍💨`,{anim:'idle',badge:'💨',dur:2600,voice:false});
        this.start();return;
      } else {
        this.round++;
        if(this.round>cfg.rounds){ this.interval=null;this.mode='countdown';Snd.fire('finish');
          Coach.say('اینتروال تموم شد! دمت گرم 🔥',{anim:'cheer',badge:'🏁',dur:5000});confetti(50);this.render();return; }
        this.phase='work';this.total=cfg.work;this.remain=cfg.work;Snd.fire('start');
        Coach.say(`دور <b class="text-pri">${fa(this.round)}</b>! بزن بریم 🚀`,{anim:'lift',badge:'🔥',dur:2400,voice:false});
        this.start();return;
      }
    }
    Snd.fire('timer_end');
    Coach.emit('restEnd');
    document.body.classList.add('flash');setTimeout(()=>document.body.classList.remove('flash'),1600);
    if(this.onEnd){const f=this.onEnd;this.onEnd=null;f()}
    this.render();
  },
  async lock(){ if(!S.settings.timer.wake)return; try{this.wake=await navigator.wakeLock.request('screen')}catch(e){} },
  unlock(){ try{this.wake&&this.wake.release();this.wake=null}catch(e){} },
  render(){
    const pct=this.total?(this.remain/this.total):0;
    const mn=$('#mini');
    if((this.running||this.remain>0&&this.remain<this.total)&&VIEW!=='timer'){mn.classList.add('on');
      $('#miniTxt').textContent=mmss(this.remain);$('#miniBar').style.width=(pct*100)+'%';
      $('#miniBtn').textContent=this.running?'⏸':'▶';
    } else mn.classList.remove('on');
    if(VIEW==='timer')renderTimerFace();
  }
};

/* ==========================================================================
   ۷) جلسه‌ی زنده
   ========================================================================== */
const Live={
  active:false,plan:null,log:[],started:0,lastAct:0,_water:0,
  start(planId){
    const p=S.plans.find(x=>x.id===planId); if(!p)return toast('برنامه پیدا نشد');
    this.active=true;this.plan=structuredClone(p);this.log=[];this.started=Date.now();this.lastAct=Date.now();this._water=0;
    Coach.emit('start'); go('session');
  },
  totalSets(){return this.plan.ex.reduce((a,e)=>a+e.sets.length,0)},
  doneSets(){return this.log.filter(l=>l.done).length},
  volume(){return this.log.filter(l=>l.done).reduce((a,l)=>a+(+l.w||0)*(+l.r||0),0)},
  toggleSet(ei,si,reps,w){
    const ex=this.plan.ex[ei],st=ex.sets[si];
    const key=ei+'_'+si;
    let l=this.log.find(x=>x.k===key);
    if(!l){l={k:key,exId:ex.exId,name:ex.name,set:si+1,r:reps,w:w,done:false};this.log.push(l)}
    l.r=reps;l.w=w;l.done=!l.done;this.lastAct=Date.now();
    if(l.done){
      const left=this.totalSets()-this.doneSets();
      Coach.emit('set',{left});
      /* بررسی رکورد */
      const pr=bestOf(ex.exId);
      if(+w>0&&+w>pr){ Coach.emit('pr',{w}); }
      if(S.settings.timer.autoRest&&left>0){
        const rest=st.rest||ex.rest||S.settings.timer.defaultRest;
        Timer.startCustom(rest,{label:'استراحت'});
        setTimeout(()=>Coach.emit('rest',{sec:rest}),900);
      }
    }
    save();renderSession();
  },
  addSet(ei){
    const ex=this.plan.ex[ei];const last=ex.sets[ex.sets.length-1]||{reps:10,w:0,rest:90};
    ex.sets.push({...structuredClone(last),type:'normal',extra:true});
    this.lastAct=Date.now();renderSession();
  },
  finish(){
    const dur=Math.round((Date.now()-this.started)/60000);
    const done=this.log.filter(l=>l.done);
    if(!done.length){ if(!confirm('هیچ ستی ثبت نشده. لغو بشه؟'))return; this.active=false;return go('home'); }
    const ses={id:uid(),date:todayKey(),ts:Date.now(),planId:this.plan.id,title:this.plan.title,
      dur,sets:done.length,volume:this.volume(),log:done};
    S.sessions.unshift(ses);
    const isNew=Prog.record();
    this.active=false;save();
    Coach.emit('finish');
    openSheet(`
      <div class="text-center py-3">
        <div class="text-6xl mb-2">🎉</div>
        <h2 class="text-2xl font-black grad-t">تمرین تموم شد!</h2>
        <p class="text-mut text-sm mt-1">${esc(this.plan.title)}</p>
        <div class="grid grid-cols-3 gap-2 mt-5">
          ${stat('⏱️',fa(dur)+' دقیقه','زمان')}
          ${stat('✅',fa(done.length),'ست')}
          ${stat('🏋️',fa(Math.round(this.volume())),'کیلو حجم')}
        </div>
        <div class="card p-3 mt-3 text-sm">
          ${isNew?`🔥 روز <b class="text-pri">${fa(S.progress.days)}</b>ام · استریک <b class="text-acc">${fa(S.progress.streak)}</b> روز`:'امروز قبلاً ثبت شده بود'}
          <div class="mt-1 text-mut text-xs">+۶۰ XP · سطح ${fa(S.progress.level)}</div>
        </div>
        <button onclick="closeSheet();go('home')" class="btn btn-p w-full py-3 mt-4">عالیه! 💪</button>
      </div>`);
  }
};
function bestOf(exId){
  let m=0;S.sessions.forEach(s=>s.log.forEach(l=>{if(l.exId===exId)m=Math.max(m,+l.w||0)}));return m;
}
function lastPerf(exId){
  for(const s of S.sessions){const l=s.log.filter(x=>x.exId===exId);if(l.length)return`${fa(l.length)}×${fa(l[0].r)} @ ${fa(l[0].w)}`}
  return null;
}

/* ==========================================================================
   ۸) ابزار UI
   ========================================================================== */
function toast(msg,icon='ℹ️'){
  const d=document.createElement('div');
  d.className='fixed left-1/2 -translate-x-1/2 bottom-28 z-[90] card px-4 py-2.5 text-sm font-bold glow-sm pop';
  d.innerHTML=icon+' '+msg;document.body.appendChild(d);
  setTimeout(()=>{d.style.opacity=0;d.style.transition='.3s';setTimeout(()=>d.remove(),320)},2200);
}
function confetti(n=60){
  const C=['#00D4FF','#7C3AED','#FF6B35','#39FF14','#F59E0B','#EF4444','#A78BFA'];
  for(let i=0;i<n;i++){const e=document.createElement('div');e.className='confetti';
    e.style.left=Math.random()*100+'vw';e.style.background=C[i%C.length];
    e.style.animationDelay=Math.random()*.6+'s';e.style.animationDuration=(1.8+Math.random()*1.4)+'s';
    document.body.appendChild(e);setTimeout(()=>e.remove(),3600)}
}
function openSheet(html){$('#sheetBody').innerHTML=`<div class="w-12 h-1.5 rounded-full bg-mut/40 mx-auto mb-3"></div>`+html;$('#sheet').classList.add('open')}
function closeSheet(){$('#sheet').classList.remove('open')}
const stat=(i,v,l)=>`<div class="card p-3 text-center"><div class="text-xl">${i}</div><div class="font-black text-base mt-1">${v}</div><div class="text-[10px] text-mut">${l}</div></div>`;

function particles(){
  if(!S.settings.particles)return;
  for(let i=0;i<14;i++){const p=document.createElement('div');p.className='particle';
    const s=2+Math.random()*4;p.style.width=p.style.height=s+'px';
    p.style.left=Math.random()*100+'vw';p.style.animationDuration=(14+Math.random()*16)+'s';
    p.style.animationDelay=(-Math.random()*20)+'s';document.body.appendChild(p)}
}

/* ==========================================================================
   ۹) ROUTER
   ========================================================================== */
let VIEW='home',PARAM=null;
function go(v,p=null){VIEW=v;PARAM=p;location.hash='#/'+v+(p?'/'+p:'');render();window.scrollTo(0,0)}
function render(){
  $$('.nv').forEach(b=>b.classList.toggle('on',b.dataset.nav===VIEW));
  const R={home:renderHome,week:renderWeek,timer:renderTimer,exercises:renderExercises,
    stats:renderStats,settings:renderSettings,plans:renderPlans,builder:renderBuilder,
    exform:renderExForm,session:renderSession,photos:renderPhotos,sounds:renderSounds,notes:renderNotes};
  (R[VIEW]||renderHome)();
  $('#app').classList.remove('fade-in');void $('#app').offsetWidth;$('#app').classList.add('fade-in');
  Timer.render();
}
addEventListener('hashchange',()=>{const[,v,p]=location.hash.replace('#/','').split('/');});

/* ==========================================================================
   ۱۰) صفحه‌ی خانه
   ========================================================================== */
function greet(){
  const h=new Date().getHours();
  if(h<5)return['شب‌بخیر','🌙'];if(h<12)return['صبح بخیر','🌅'];
  if(h<17)return['ظهر بخیر','☀️'];if(h<21)return['عصر بخیر','🌇'];return['شب بخیر','🌙'];
}
function dailyQuote(){
  const all=[...QUOTES,...S.quotesCustom];
  const i=Math.floor(Date.now()/864e5)%all.length;return all[i];
}
function renderHome(){
  const[g,gi]=greet(),P=S.progress,d=pDay(new Date());
  const sch=S.schedule[d]||{},plan=S.plans.find(p=>p.id===sch.planId);
  const wk=last7();
  $('#app').innerHTML=`
  <!-- Hero -->
  <div class="card p-5 glow relative overflow-hidden">
    <div class="absolute -top-10 -left-10 w-40 h-40 rounded-full grad opacity-20 blur-2xl"></div>
    <div class="relative">
      <div class="text-mut text-xs">${gi} ${g}</div>
      <h1 class="text-2xl font-black mt-1">${esc(S.user.name||'قهرمان')} <span class="inline-block" style="animation:bIdle 2s infinite">👋</span></h1>
      <div class="flex flex-wrap items-center gap-2 mt-3">
        <div class="chip">💪 روز <b>${fa(P.days+1)}</b>اُم</div>
        <div class="chip">🔥 ${fa(P.streak)} روز پشت‌سرهم</div>
        <div class="chip">⭐ سطح ${fa(P.level)}</div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-[10px] text-mut mb-1"><span>XP تا سطح بعد</span><span>${fa(P.xp%400)}/۴۰۰</span></div>
        <div class="bar"><i style="width:${(P.xp%400)/4}%"></i></div>
      </div>
    </div>
  </div>

  <!-- Quote -->
  <div class="card p-4 mt-3 border-r-4" style="border-right-color:rgb(var(--c-pri))">
    <div class="text-[13px] leading-7">💬 ${esc(dailyQuote())}</div>
  </div>

  <!-- Today -->
  <div class="card p-4 mt-3">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-black">📋 امروز · ${DAYS[d]}</h2>
      <span class="text-[11px] text-mut">${faDate(new Date())}</span>
    </div>
    ${sch.status==='rest'?`
      <div class="text-center py-5">
        <div class="text-5xl mb-2">🛌</div>
        <div class="font-bold">روز استراحت</div>
        <div class="text-xs text-mut mt-1">ریکاوری هم بخشی از تمرینه</div>
        <button onclick="go('week')" class="btn btn-g px-4 py-2 mt-3 text-sm">تغییر برنامه هفته</button>
      </div>`
    : plan?`
      <div class="rounded-2xl p-4" style="background:linear-gradient(135deg,rgb(var(--c-pri)/.16),rgb(var(--c-sec)/.16))">
        <div class="font-black text-lg">${esc(plan.title)}</div>
        <div class="text-xs text-mut mt-1">${fa(plan.ex.length)} حرکت · ${fa(plan.ex.reduce((a,e)=>a+e.sets.length,0))} ست · ~${fa(estMin(plan))} دقیقه</div>
        <div class="flex gap-1 flex-wrap mt-2">${plan.ex.slice(0,4).map(e=>`<span class="text-[10px] px-2 py-1 rounded-lg bg-surf2">${esc(e.name)}</span>`).join('')}${plan.ex.length>4?`<span class="text-[10px] px-2 py-1 text-mut">+${fa(plan.ex.length-4)}</span>`:''}</div>
      </div>
      <button onclick="Live.start('${plan.id}')" class="btn btn-p w-full py-3.5 mt-3 text-base">▶️ شروع تمرین</button>`
    :`<div class="text-center py-5">
        <div class="text-4xl mb-2">🤔</div>
        <div class="text-sm text-mut">برای امروز برنامه‌ای تنظیم نشده</div>
        <button onclick="go('plans')" class="btn btn-p px-5 py-2.5 mt-3 text-sm">+ ساخت برنامه</button>
      </div>`}
  </div>

  <!-- Week rings -->
  <div class="card p-4 mt-3">
    <div class="flex items-center justify-between mb-3"><h2 class="font-black text-sm">📈 ۷ روز اخیر</h2>
      <span class="text-[11px] text-mut">${fa(wk.filter(x=>x.has).length)} جلسه</span></div>
    <div class="flex justify-between">${wk.map(x=>`
      <div class="text-center flex-1">
        <div class="mx-auto w-9 h-9 rounded-xl grid place-items-center text-sm font-black ${x.has?'grad text-white glow-sm':'bg-surf2 text-mut'}">${x.has?'✓':fa(x.n)}</div>
        <div class="text-[9px] text-mut mt-1">${x.d}</div>
      </div>`).join('')}</div>
    <div class="mt-3 text-[11px] text-mut text-center">🏆 ${fa(Prog.next()-P.days)} روز تا نشان «${fa(Prog.next())} جلسه»</div>
  </div>

  <!-- Quick -->
  <div class="grid grid-cols-4 gap-2 mt-3">
    ${qa('⏱️','تایمر',"go('timer')")}${qa('🧩','برنامه‌ها',"go('plans')")}
    ${qa('📸','عکس بدن',"go('photos')")}${qa('📝','یادداشت',"go('notes')")}
  </div>

  ${P.badges.length?`<div class="card p-4 mt-3">
    <h2 class="font-black text-sm mb-2">🎖️ نشان‌های من</h2>
    <div class="flex flex-wrap gap-2">${P.badges.map(b=>`<div class="chip">${b.i} ${esc(b.t)}</div>`).join('')}</div></div>`:''}
  `;
  if(!S.user.onboarded)onboarding();
  else if(!sessionStorage.getItem('greeted')){
    sessionStorage.setItem('greeted','1');
    setTimeout(()=>{
      Prog.checkStreak();
      const diff=P.last?Math.floor((new Date(todayKey())-new Date(P.last))/864e5):99;
      if(sch.status==='rest')Coach.emit('rest_day');
      else if(diff>1&&P.last)Coach.emit('miss');
      else Coach.say(`${gi} <b>${esc(S.user.name||'قهرمان')}</b>! 👋<br>امروز روز <b class="text-pri">${fa(P.days+1)}</b>اُم تمرینته 🔥<br><span class="text-mut text-xs">${esc(dailyQuote())}</span>`,{anim:'cheer',badge:'👋',dur:7000});
    },700);
  }
}
const qa=(i,t,fn)=>`<button onclick="${fn}" class="card p-3 text-center active:scale-95 transition"><div class="text-xl">${i}</div><div class="text-[10px] font-bold mt-1">${t}</div></button>`;
function last7(){
  const r=[];for(let i=6;i>=0;i--){const d=new Date(Date.now()-i*864e5),k=d.toISOString().slice(0,10);
    r.push({d:DAYS[pDay(d)].slice(0,3),n:d.getDate(),has:S.sessions.some(s=>s.date===k)})}return r;
}
const estMin=p=>Math.round(p.ex.reduce((a,e)=>a+e.sets.length*((e.rest||90)+40)/60,0));

function onboarding(){
  openSheet(`
   <div class="text-center">
     <div class="text-6xl mb-2" style="animation:bIdle 2s infinite">🏋️‍♂️</div>
     <h2 class="text-xl font-black grad-t">خوش اومدی به جیم‌بادی!</h2>
     <p class="text-xs text-mut mt-1">مربی شخصی‌ات رو بشناس</p>
   </div>
   <div class="space-y-3 mt-5">
     <div><label class="text-xs text-mut">اسمت چیه؟</label><input id="obName" class="inp mt-1" placeholder="مثلاً علی"></div>
     <div><label class="text-xs text-mut">هدفت؟</label>
       <select id="obGoal" class="inp mt-1"><option>حجم</option><option>کات / چربی‌سوزی</option><option>قدرت</option><option>تناسب اندام</option></select></div>
     <div><label class="text-xs text-mut">اسم مربی‌ات</label><input id="obCoach" class="inp mt-1" value="رفیق"></div>
     <div><label class="text-xs text-mut">لحن مربی</label>
       <select id="obPer" class="inp mt-1">
         <option value="friendly">😊 رفیق صمیمی</option><option value="tough">😤 سخت‌گیر</option>
         <option value="funny">😂 شوخ</option><option value="pro">🧑‍🔬 حرفه‌ای</option><option value="calm">🧘 آرام</option></select></div>
     <button onclick="finishOb()" class="btn btn-p w-full py-3">بزن بریم! 🚀</button>
   </div>`);
}
function finishOb(){
  S.user.name=$('#obName').value.trim()||'قهرمان';
  S.user.goal=$('#obGoal').value;S.user.onboarded=true;S.user.startDate=todayKey();
  S.settings.coach.name=$('#obCoach').value.trim()||'رفیق';
  S.settings.coach.persona=$('#obPer').value;
  save();closeSheet();render();
  setTimeout(()=>Coach.say(`سلام <b>${esc(S.user.name)}</b>! من ${esc(S.settings.coach.name)}م 💪<br>از امروز کنارتم. بزن بریم!`,{anim:'cheer',badge:'🎉',dur:6000}),500);
  confetti(40);
}

/* ==========================================================================
   ۱۱) هفته
   ========================================================================== */
function renderWeek(){
  const td=pDay(new Date());
  $('#app').innerHTML=`
  <h1 class="text-xl font-black mb-1">📅 برنامه‌ی هفتگی</h1>
  <p class="text-xs text-mut mb-4">روزهای تمرین و استراحتت رو تنظیم کن</p>
  <div class="space-y-2">
  ${DAYS.map((dn,i)=>{const s=S.schedule[i]||{},p=S.plans.find(x=>x.id===s.planId);
   return`<div class="card p-3 ${i===td?'glow':''}">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl grid place-items-center font-black text-sm ${s.status==='rest'?'bg-surf2 text-mut':'grad text-white'}">${dn.slice(0,3)}</div>
      <div class="flex-1 min-w-0">
        <div class="font-bold text-sm flex items-center gap-1">${dn} ${i===td?'<span class="chip !text-[9px] !py-0">امروز</span>':''}</div>
        <div class="text-[11px] text-mut truncate">${s.status==='rest'?'🛌 استراحت':(p?`🏋️ ${esc(p.title)} · ${fa(p.ex.length)} حرکت`:'⚠️ برنامه انتخاب نشده')}</div>
      </div>
      <button onclick="dayEdit(${i})" class="btn btn-g w-9 h-9">✏️</button>
    </div>
    ${s.note?`<div class="text-[11px] text-mut mt-2 pt-2 border-t border-white/5">📝 ${esc(s.note)}</div>`:''}
   </div>`}).join('')}
  </div>
  <button onclick="go('plans')" class="btn btn-g w-full py-3 mt-4">🧩 مدیریت برنامه‌ها</button>`;
}
function dayEdit(i){
  const s=S.schedule[i];
  openSheet(`
   <h2 class="font-black text-lg mb-4">${DAYS[i]}</h2>
   <div class="grid grid-cols-3 gap-2">
     ${['train:🏋️ تمرین','rest:🛌 استراحت','active:🚶 فعال'].map(o=>{const[v,t]=o.split(':');
       return`<button onclick="setDay(${i},'${v}')" class="btn ${s.status===v?'btn-p':'btn-g'} py-3 text-xs">${t}</button>`}).join('')}
   </div>
   <div class="mt-4"><label class="text-xs text-mut">برنامه‌ی تمرینی</label>
     <select id="dPlan" class="inp mt-1" onchange="S.schedule[${i}].planId=this.value||null;save();renderWeek()">
       <option value="">— انتخاب کن —</option>
       ${S.plans.map(p=>`<option value="${p.id}" ${s.planId===p.id?'selected':''}>${esc(p.title)}</option>`).join('')}
     </select></div>
   <div class="mt-3"><label class="text-xs text-mut">ساعت</label>
     <input type="time" class="inp mt-1" value="${s.time||'18:00'}" onchange="S.schedule[${i}].time=this.value;save()"></div>
   <div class="mt-3"><label class="text-xs text-mut">یادداشت این روز</label>
     <textarea class="inp mt-1" rows="3" placeholder="مثلاً: گرم‌کردن ۱۰ دقیقه دوچرخه..." onchange="S.schedule[${i}].note=this.value;save();renderWeek()">${esc(s.note||'')}</textarea></div>
   <button onclick="closeSheet();renderWeek()" class="btn btn-p w-full py-3 mt-4">ذخیره ✅</button>`);
}
function setDay(i,v){S.schedule[i].status=v;save();dayEdit(i);renderWeek()}

/* ==========================================================================
   ۱۲) برنامه‌ها + سازنده
   ========================================================================== */
function renderPlans(){
  $('#app').innerHTML=`
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-black">🧩 برنامه‌های من</h1>
    <button onclick="newPlan()" class="btn btn-p px-4 py-2 text-sm">+ جدید</button>
  </div>
  ${S.plans.length?`<div class="space-y-2">${S.plans.map(p=>`
    <div class="card p-4">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1 min-w-0" onclick="go('builder','${p.id}')">
          <div class="font-black">${esc(p.title)}</div>
          <div class="text-[11px] text-mut mt-1">${fa(p.ex.length)} حرکت · ${fa(p.ex.reduce((a,e)=>a+e.sets.length,0))} ست · ~${fa(estMin(p))}′</div>
          <div class="flex gap-1 flex-wrap mt-2">${p.ex.slice(0,5).map(e=>`<span class="text-[10px] px-2 py-0.5 rounded-lg bg-surf2">${esc(e.name)}</span>`).join('')}</div>
        </div>
        <div class="flex flex-col gap-1">
          <button onclick="Live.start('${p.id}')" class="btn btn-p w-9 h-9 text-xs">▶</button>
          <button onclick="go('builder','${p.id}')" class="btn btn-g w-9 h-9 text-xs">✏️</button>
          <button onclick="delPlan('${p.id}')" class="btn btn-g w-9 h-9 text-xs">🗑</button>
        </div>
      </div>
    </div>`).join('')}</div>`
  :`<div class="card p-8 text-center"><div class="text-5xl mb-2">🧩</div><p class="text-sm text-mut">هنوز برنامه‌ای نساختی</p>
    <button onclick="newPlan()" class="btn btn-p px-5 py-2.5 mt-3 text-sm">+ اولین برنامه</button></div>`}`;
}
function newPlan(){
  const p={id:uid(),title:'برنامه‌ی جدید',color:'pri',ex:[],created:Date.now()};
  S.plans.unshift(p);save();go('builder',p.id);
}
function delPlan(id){if(!confirm('حذف شود؟'))return;S.plans=S.plans.filter(p=>p.id!==id);
  Object.values(S.schedule).forEach(s=>{if(s.planId===id)s.planId=null});save();renderPlans()}

/* ---------- Builder ---------- */
function renderBuilder(){
  const p=S.plans.find(x=>x.id===PARAM); if(!p)return go('plans');
  const totalSets=p.ex.reduce((a,e)=>a+e.sets.length,0);
  $('#app').innerHTML=`
  <button onclick="go('plans')" class="text-xs text-mut mb-2">‹ برگشت</button>
  <input class="inp !text-lg !font-black mb-3" value="${esc(p.title)}" oninput="plTitle('${p.id}',this.value)">
  <div class="card p-3 mb-3 flex justify-around text-center text-xs">
    <div><div class="font-black text-base text-pri">${fa(p.ex.length)}</div><div class="text-mut">حرکت</div></div>
    <div><div class="font-black text-base text-acc">${fa(totalSets)}</div><div class="text-mut">ست</div></div>
    <div><div class="font-black text-base">${fa(estMin(p))}′</div><div class="text-mut">زمان</div></div>
  </div>

  <!-- Quick add -->
  <div class="card p-3 mb-3">
    <label class="text-[11px] text-mut">⚡ افزودن سریع (مثال: <b>اسکات 4x8 @80 r90</b>)</label>
    <div class="flex gap-2 mt-1">
      <input id="qa" class="inp" placeholder="اسکات 4x8 @80 r90" onkeydown="if(event.key==='Enter')quickAdd('${p.id}')">
      <button onclick="quickAdd('${p.id}')" class="btn btn-p px-4">➕</button>
    </div>
  </div>

  <div class="space-y-3">
  ${p.ex.map((e,i)=>`
   <div class="card p-3">
     <div class="flex items-center gap-2 mb-2">
       <div class="flex flex-col">
         <button onclick="mvEx('${p.id}',${i},-1)" class="text-xs text-mut px-1">▲</button>
         <button onclick="mvEx('${p.id}',${i},1)" class="text-xs text-mut px-1">▼</button>
       </div>
       <div class="flex-1 min-w-0">
         <div class="font-black text-sm truncate">${esc(e.name)}</div>
         <div class="text-[10px] text-mut">${esc(e.muscle||'')} ${e.ss?`· سوپرست ${e.ss}`:''} ${lastPerf(e.exId)?'· قبلی: '+lastPerf(e.exId):''}</div>
       </div>
       <select onchange="setSS('${p.id}',${i},this.value)" class="inp !w-16 !py-1 !text-[11px]">
         <option value="">—</option>${['A','B','C'].map(g=>`<option ${e.ss===g?'selected':''}>${g}</option>`).join('')}</select>
       <button onclick="delEx('${p.id}',${i})" class="btn btn-g w-8 h-8 text-xs">🗑</button>
     </div>
     <!-- sets table -->
     <div class="space-y-1">
       <div class="grid grid-cols-[28px_60px_1fr_1fr_52px_28px] gap-1 text-[9px] text-mut px-1">
         <span>#</span><span>نوع</span><span>تکرار</span><span>وزن</span><span>استراحت</span><span></span></div>
       ${e.sets.map((s,j)=>`
       <div class="grid grid-cols-[28px_60px_1fr_1fr_52px_28px] gap-1 items-center">
         <div class="text-[11px] text-center font-bold ${s.type==='warmup'?'text-amber-400':''}">${s.type==='warmup'?'W':fa(j+1)}</div>
         <select class="inp !py-1 !px-1 !text-[10px]" onchange="setS('${p.id}',${i},${j},'type',this.value)">
           ${[['normal','اصلی'],['warmup','گرم'],['drop','دراپ'],['amrap','AMRAP'],['fail','ناتوان']].map(([v,t])=>`<option value="${v}" ${s.type===v?'selected':''}>${t}</option>`).join('')}</select>
         <input class="inp !py-1 !px-2 !text-[12px] text-center" value="${esc(s.reps)}" onchange="setS('${p.id}',${i},${j},'reps',this.value)">
         <input class="inp !py-1 !px-2 !text-[12px] text-center" type="number" step="0.5" value="${s.w??''}" onchange="setS('${p.id}',${i},${j},'w',this.value)">
         <input class="inp !py-1 !px-1 !text-[11px] text-center" type="number" value="${s.rest??e.rest??90}" onchange="setS('${p.id}',${i},${j},'rest',this.value)">
         <button onclick="delS('${p.id}',${i},${j})" class="text-[11px] text-red-400">✕</button>
       </div>`).join('')}
     </div>
     <div class="flex gap-1 mt-2">
       <button onclick="addS('${p.id}',${i})" class="btn btn-g flex-1 py-1.5 text-[11px]">+ ست</button>
       <button onclick="dupS('${p.id}',${i})" class="btn btn-g flex-1 py-1.5 text-[11px]">📋 کپی آخری</button>
       <button onclick="schemeMenu('${p.id}',${i})" class="btn btn-g flex-1 py-1.5 text-[11px]">⚡ الگو</button>
     </div>
   </div>`).join('')}
  </div>

  <button onclick="pickExercise('${p.id}')" class="btn btn-p w-full py-3.5 mt-3">➕ افزودن حرکت</button>
  <button onclick="go('week')" class="btn btn-g w-full py-3 mt-2 text-sm">📅 اتصال به روز هفته</button>`;
}
function plTitle(id,v){const p=S.plans.find(x=>x.id===id);p.title=v;save()}
function mvEx(id,i,d){const p=S.plans.find(x=>x.id===id),j=i+d;if(j<0||j>=p.ex.length)return;
  [p.ex[i],p.ex[j]]=[p.ex[j],p.ex[i]];save();renderBuilder()}
function delEx(id,i){const p=S.plans.find(x=>x.id===id);p.ex.splice(i,1);save();renderBuilder()}
function setSS(id,i,v){const p=S.plans.find(x=>x.id===id);p.ex[i].ss=v||null;save()}
function setS(id,i,j,k,v){const p=S.plans.find(x=>x.id===id);p.ex[i].sets[j][k]=(k==='reps'||k==='type')?v:(v===''?null:+v);save();if(k==='type')renderBuilder()}
function addS(id,i){const p=S.plans.find(x=>x.id===id),e=p.ex[i],l=e.sets[e.sets.length-1];
  e.sets.push(l?structuredClone(l):{type:'normal',reps:'10',w:0,rest:90});save();renderBuilder()}
function dupS(id,i){addS(id,i)}
function delS(id,i,j){const p=S.plans.find(x=>x.id===id);p.ex[i].sets.splice(j,1);save();renderBuilder()}
function schemeMenu(id,i){
  const SC=[['۳×۱۲ (حجم)',[[12,3]]],['۴×۸',[[8,4]]],['۵×۵ (قدرت)',[[5,5]]],
   ['هرمی ۱۲-۱۰-۸-۶',[[12,1],[10,1],[8,1],[6,1]]],['۲ گرم + ۳ اصلی','warm']];
  openSheet(`<h2 class="font-black mb-3">⚡ اعمال الگوی ست</h2>
   ${SC.map((s,k)=>`<button onclick="applyScheme('${id}',${i},${k})" class="btn btn-g w-full py-3 mb-2 text-sm">${s[0]}</button>`).join('')}`);
}
function applyScheme(id,i,k){
  const p=S.plans.find(x=>x.id===id),e=p.ex[i];
  const base={type:'normal',w:e.sets[0]?.w||0,rest:e.rest||90};
  const S4=[[[12,3]],[[8,4]],[[5,5]],[[12,1],[10,1],[8,1],[6,1]],'warm'][k];
  if(S4==='warm'){e.sets=[{...base,type:'warmup',reps:'12',w:Math.round((base.w||40)*.5)},{...base,type:'warmup',reps:'10',w:Math.round((base.w||40)*.7)},
    {...base,reps:'8'},{...base,reps:'8'},{...base,reps:'8'}]}
  else{e.sets=[];S4.forEach(([r,n])=>{for(let z=0;z<n;z++)e.sets.push({...base,reps:String(r)})})}
  save();closeSheet();renderBuilder();
}
function quickAdd(pid){
  const v=$('#qa').value.trim();if(!v)return;
  const m=v.match(/^(.+?)\s+(\d+)\s*[x×]\s*([\w\u0600-\u06FF\-]+)(?:\s*@\s*([\d.]+))?(?:\s*r\s*(\d+))?$/i);
  if(!m)return toast('فرمت: اسکات 4x8 @80 r90','⚠️');
  const[,name,sets,reps,w,rest]=m;
  let ex=S.exercises.find(e=>e.name.trim()===name.trim());
  if(!ex){ex={id:uid(),name:name.trim(),muscle:'عمومی',equip:'',measure:'weight_reps',def:{sets:+sets,reps:+reps||10,rest:+rest||90},desc:'',tip:'',media:[],cover:null,fav:false,uses:0,created:Date.now()};S.exercises.unshift(ex)}
  addExToPlan(pid,ex.id,{sets:+sets,reps,w:+w||0,rest:+rest||90});
  $('#qa').value='';toast('اضافه شد ✅','⚡');
}
function pickExercise(pid){
  openSheet(`<h2 class="font-black mb-2">📚 انتخاب حرکت</h2>
   <input id="exSearch" class="inp mb-3" placeholder="جستجو..." oninput="filterPick('${pid}')">
   <button onclick="closeSheet();go('exform','new:${pid}')" class="btn btn-p w-full py-2.5 mb-3 text-sm">➕ ساخت حرکت جدید</button>
   <div id="pickList" class="space-y-1 max-h-[46vh] overflow-y-auto"></div>`);
  filterPick(pid);
}
function filterPick(pid){
  const q=($('#exSearch')?.value||'').trim();
  const list=S.exercises.filter(e=>!q||e.name.includes(q)||(e.muscle||'').includes(q)).sort((a,b)=>b.uses-a.uses);
  $('#pickList').innerHTML=list.map(e=>`
   <button onclick="addExToPlan('${pid}','${e.id}');closeSheet()" class="card w-full p-2.5 flex items-center gap-2 text-right">
     <div class="w-9 h-9 rounded-lg bg-surf2 grid place-items-center text-sm">🏋️</div>
     <div class="flex-1 min-w-0"><div class="font-bold text-sm truncate">${esc(e.name)}</div>
       <div class="text-[10px] text-mut">${esc(e.muscle)} · ${esc(e.equip||'')}</div></div>
     <span class="text-pri text-lg">+</span></button>`).join('')||'<p class="text-center text-mut text-xs py-4">چیزی پیدا نشد</p>';
}
function addExToPlan(pid,exId,opt={}){
  const p=S.plans.find(x=>x.id===pid),ex=S.exercises.find(e=>e.id===exId);if(!p||!ex)return;
  const n=opt.sets||ex.def.sets||3,reps=String(opt.reps??ex.def.reps??10),rest=opt.rest||ex.def.rest||90;
  const sets=[];for(let i=0;i<n;i++)sets.push({type:'normal',reps,w:opt.w??0,rest});
  p.ex.push({exId,name:ex.name,muscle:ex.muscle,rest,sets,ss:null});
  ex.uses++;save();renderBuilder();
}

/* ==========================================================================
   ۱۳) کتابخانه‌ی حرکات (با عکس/ویدیو/متن)
   ========================================================================== */
let exFilter='';
function renderExercises(){
  const list=S.exercises.filter(e=>!exFilter||e.name.includes(exFilter)||(e.muscle||'').includes(exFilter));
  const groups={};list.forEach(e=>{(groups[e.muscle||'سایر']=groups[e.muscle||'سایر']||[]).push(e)});
  $('#app').innerHTML=`
  <div class="flex items-center justify-between mb-3">
    <h1 class="text-xl font-black">📚 حرکات من</h1>
    <button onclick="go('exform','new')" class="btn btn-p px-4 py-2 text-sm">+ جدید</button></div>
  <input class="inp mb-3" placeholder="🔍 جستجو..." value="${esc(exFilter)}" oninput="exFilter=this.value;renderExercises()">
  ${Object.entries(groups).map(([g,arr])=>`
   <div class="mb-4"><div class="text-xs text-mut font-bold mb-2">${esc(g)} · ${fa(arr.length)}</div>
   <div class="grid grid-cols-2 gap-2">${arr.map(e=>`
    <div onclick="viewEx('${e.id}')" class="card p-3 active:scale-95 transition">
      <div class="w-full aspect-video rounded-xl bg-surf2 grid place-items-center text-2xl mb-2 overflow-hidden" id="cov_${e.id}">${e.cover?'':'🏋️'}</div>
      <div class="font-bold text-[13px] truncate">${esc(e.name)}</div>
      <div class="text-[10px] text-mut truncate">${esc(e.equip||'')} · ${fa(e.def.sets)}×${fa(e.def.reps)}</div>
      ${bestOf(e.id)?`<div class="text-[10px] text-acc mt-1">🏆 ${fa(bestOf(e.id))}kg</div>`:''}
    </div>`).join('')}</div></div>`).join('')||'<p class="text-center text-mut py-10">حرکتی نیست</p>'}`;
  S.exercises.forEach(async e=>{ if(e.cover){const u=await mediaURL(e.cover);const el=$('#cov_'+e.id);
    if(u&&el)el.innerHTML=`<img src="${u}" class="w-full h-full object-cover">`}});
}
async function viewEx(id){
  const e=S.exercises.find(x=>x.id===id);if(!e)return;
  const urls=await Promise.all((e.media||[]).map(m=>mediaURL(m)));
  openSheet(`
   <div class="flex items-start justify-between gap-2 mb-3">
     <div><h2 class="font-black text-lg">${esc(e.name)}</h2>
       <div class="text-[11px] text-mut">${esc(e.muscle)} · ${esc(e.equip||'')}</div></div>
     <div class="flex gap-1">
       <button onclick="closeSheet();go('exform','${e.id}')" class="btn btn-g w-9 h-9">✏️</button>
       <button onclick="delEx2('${e.id}')" class="btn btn-g w-9 h-9">🗑</button></div>
   </div>
   <div class="flex gap-2 text-center mb-3">
     ${stat('🔢',fa(e.def.sets)+'×'+fa(e.def.reps),'پیش‌فرض')}
     ${stat('⏱️',fa(e.def.rest)+'s','استراحت')}
     ${stat('🏆',fa(bestOf(e.id))+'kg','رکورد')}
   </div>
   ${e.tip?`<div class="card p-3 text-[13px] mb-3 border-r-4" style="border-right-color:rgb(var(--c-acc))">💡 ${esc(e.tip)}</div>`:''}
   ${e.desc?`<div class="card p-3 text-[13px] leading-7 whitespace-pre-wrap mb-3">${esc(e.desc)}</div>`:''}
   ${urls.filter(Boolean).length?`<div class="grid grid-cols-2 gap-2">${(e.media||[]).map((m,i)=>{
      const t=urls[i];if(!t)return'';
      return S.exercises&&m&&/video/.test(m)?'':`<div class="rounded-xl overflow-hidden bg-surf2" id="mw_${m}"></div>`}).join('')}</div>`:''}
   <div id="mediaHolder" class="grid grid-cols-2 gap-2"></div>`);
  /* رندر مدیا */
  const holder=$('#mediaHolder');
  for(const mid of (e.media||[])){
    const rec=await idbGet('media',mid); if(!rec)continue;
    const u=await mediaURL(mid);
    holder.insertAdjacentHTML('beforeend', rec.type==='video'
      ? `<video src="${u}" controls playsinline class="w-full rounded-xl bg-black"></video>`
      : `<img src="${u}" class="w-full rounded-xl object-cover">`);
  }
}
function delEx2(id){if(!confirm('حذف شود؟'))return;S.exercises=S.exercises.filter(e=>e.id!==id);save();closeSheet();renderExercises()}

function renderExForm(){
  const isNew=String(PARAM).startsWith('new');
  const backPlan=String(PARAM).includes(':')?String(PARAM).split(':')[1]:null;
  const e=isNew?{id:uid(),name:'',muscle:'سینه',equip:'هالتر',measure:'weight_reps',def:{sets:3,reps:10,rest:90},desc:'',tip:'',media:[],cover:null,fav:false,uses:0,created:Date.now()}
            :structuredClone(S.exercises.find(x=>x.id===PARAM)||{});
  window._ef=e;
  $('#app').innerHTML=`
  <button onclick="history.back();go('exercises')" class="text-xs text-mut mb-2">‹ برگشت</button>
  <h1 class="text-xl font-black mb-4">${isNew?'➕ حرکت جدید':'✏️ ویرایش حرکت'}</h1>
  <div class="space-y-3">
    <div><label class="text-xs text-mut">نام حرکت *</label>
      <input id="efName" class="inp mt-1" value="${esc(e.name)}" placeholder="مثلاً پرس بالاسینه دمبل"></div>
    <div class="grid grid-cols-2 gap-2">
      <div><label class="text-xs text-mut">عضله</label>
        <input id="efMus" class="inp mt-1" list="muses" value="${esc(e.muscle)}">
        <datalist id="muses">${['سینه','پشت','پا','سرشانه','بازو','شکم','ساق','هوازی','عمومی'].map(m=>`<option>${m}</option>`).join('')}</datalist></div>
      <div><label class="text-xs text-mut">تجهیزات</label>
        <input id="efEq" class="inp mt-1" list="eqs" value="${esc(e.equip||'')}">
        <datalist id="eqs">${['هالتر','دمبل','دستگاه','کابل','وزن بدن','کتل‌بل','کش','اسمیت'].map(m=>`<option>${m}</option>`).join('')}</datalist></div>
    </div>
    <div><label class="text-xs text-mut">نوع سنجش</label>
      <select id="efMes" class="inp mt-1">
        ${[['weight_reps','وزن × تکرار'],['reps','فقط تکرار'],['time','زمان (ثانیه)'],['dist','مسافت/زمان']].map(([v,t])=>`<option value="${v}" ${e.measure===v?'selected':''}>${t}</option>`).join('')}</select></div>
    <div class="card p-3">
      <div class="text-xs text-mut mb-2">⚙️ پیش‌فرض‌ها (موقع افزودن به برنامه)</div>
      <div class="grid grid-cols-3 gap-2">
        <div><label class="text-[10px] text-mut">ست</label><input id="efS" type="number" class="inp mt-1 text-center" value="${e.def.sets}"></div>
        <div><label class="text-[10px] text-mut">تکرار</label><input id="efR" type="number" class="inp mt-1 text-center" value="${e.def.reps}"></div>
        <div><label class="text-[10px] text-mut">استراحت</label><input id="efT" type="number" class="inp mt-1 text-center" value="${e.def.rest}"></div>
      </div>
    </div>
    <div><label class="text-xs text-mut">💡 نکته‌ی کوتاه</label>
      <input id="efTip" class="inp mt-1" value="${esc(e.tip||'')}" placeholder="آرنج نزدیک بدن..."></div>
    <div><label class="text-xs text-mut">📝 توضیح کامل (متن دلخواه خودت)</label>
      <textarea id="efDesc" class="inp mt-1" rows="5" placeholder="نحوه اجرا، نکات فرم، اشتباهات رایج...">${esc(e.desc||'')}</textarea></div>
    <div class="card p-3">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-mut">🖼️ عکس و ویدیو</span>
        <label class="btn btn-p px-3 py-1.5 text-xs cursor-pointer">+ افزودن
          <input type="file" accept="image/*,video/*" multiple class="hidden" onchange="efUpload(this)"></label>
      </div>
      <div id="efMedia" class="grid grid-cols-3 gap-2"></div>
    </div>
    <button onclick="saveEx(${isNew},'${backPlan||''}')" class="btn btn-p w-full py-3.5">💾 ذخیره</button>
  </div>`;
  drawEfMedia();
}
async function drawEfMedia(){
  const h=$('#efMedia');if(!h)return;h.innerHTML='';
  for(const mid of (_ef.media||[])){
    const rec=await idbGet('media',mid);if(!rec)continue;const u=await mediaURL(mid);
    h.insertAdjacentHTML('beforeend',`<div class="relative aspect-square rounded-xl overflow-hidden bg-surf2">
      ${rec.type==='video'?`<video src="${u}" class="w-full h-full object-cover"></video><div class="absolute inset-0 grid place-items-center text-2xl">▶️</div>`:`<img src="${u}" class="w-full h-full object-cover">`}
      <button onclick="efDel('${mid}')" class="absolute top-1 left-1 w-6 h-6 rounded-lg bg-black/70 text-xs">✕</button>
      <button onclick="efCover('${mid}')" class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded-lg bg-black/70 text-[9px]">${_ef.cover===mid?'⭐ کاور':'کاور کن'}</button>
    </div>`);
  }
}
async function efUpload(inp){
  for(const f of inp.files){ const id=await addMedia(f); _ef.media.push(id); if(!_ef.cover&&f.type.startsWith('image'))_ef.cover=id; }
  inp.value='';drawEfMedia();toast('اضافه شد','🖼️');
}
function efDel(id){_ef.media=_ef.media.filter(m=>m!==id);if(_ef.cover===id)_ef.cover=_ef.media[0]||null;idbDel('media',id);drawEfMedia()}
function efCover(id){_ef.cover=id;drawEfMedia()}
function saveEx(isNew,backPlan){
  const n=$('#efName').value.trim();if(!n)return toast('اسم حرکت رو بنویس','⚠️');
  Object.assign(_ef,{name:n,muscle:$('#efMus').value.trim()||'عمومی',equip:$('#efEq').value.trim(),
    measure:$('#efMes').value,tip:$('#efTip').value.trim(),desc:$('#efDesc').value,
    def:{sets:+$('#efS').value||3,reps:+$('#efR').value||10,rest:+$('#efT').value||90}});
  if(isNew)S.exercises.unshift(_ef);
  else{const i=S.exercises.findIndex(x=>x.id===_ef.id);S.exercises[i]=_ef}
  save();toast('ذخیره شد ✅','💾');
  if(backPlan){addExToPlan(backPlan,_ef.id);go('builder',backPlan)}else go('exercises');
}

/* ==========================================================================
   ۱۴) تایمر
   ========================================================================== */
function renderTimer(){
  $('#app').innerHTML=`
  <h1 class="text-xl font-black mb-3">⏱️ تایمر</h1>
  <div class="card p-5 text-center glow">
    <div id="tLabel" class="text-xs text-mut mb-2"></div>
    <div class="relative w-56 h-56 mx-auto">
      <svg class="ring w-full h-full" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="88" fill="none" stroke="rgb(var(--c-surf2))" stroke-width="12"/>
        <circle id="tRing" cx="100" cy="100" r="88" fill="none" stroke="url(#g1)" stroke-width="12" stroke-linecap="round"
          stroke-dasharray="552.9" stroke-dashoffset="0"/>
        <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="rgb(var(--c-pri))"/><stop offset="100%" stop-color="rgb(var(--c-sec))"/></linearGradient></defs>
      </svg>
      <div class="absolute inset-0 grid place-items-center">
        <div><div id="tTime" class="text-5xl font-black tabular-nums">۰۰:۰۰</div>
        <div id="tSub" class="text-[11px] text-mut mt-1"></div></div>
      </div>
    </div>
    <div class="flex justify-center gap-2 mt-4">
      <button onclick="Timer.add(-15)" class="btn btn-g px-3 py-2 text-xs">−۱۵</button>
      <button onclick="Timer.toggle()" id="tMain" class="btn btn-p px-8 py-3 text-base">▶ شروع</button>
      <button onclick="Timer.add(15)" class="btn btn-g px-3 py-2 text-xs">+۱۵</button>
    </div>
    <button onclick="Timer.reset()" class="btn btn-g px-5 py-1.5 mt-2 text-xs">↺ ریست</button>
  </div>

  <div class="card p-4 mt-3">
    <div class="text-xs text-mut mb-2">🎚️ تنظیم زمان دلخواه</div>
    <div class="flex items-center gap-2">
      <input id="tMin" type="number" min="0" max="99" value="${Math.floor(Timer.total/60)||1}" class="inp text-center !text-xl !font-black">
      <span class="font-black">:</span>
      <input id="tSec" type="number" min="0" max="59" value="${Timer.total%60}" class="inp text-center !text-xl !font-black">
      <button onclick="setFromInputs()" class="btn btn-p px-4 py-3">تنظیم</button>
    </div>
    <div class="flex flex-wrap gap-1.5 mt-3">
      ${[15,30,45,60,90,120,180,300].map(s=>`<button onclick="Timer.set(${s});Timer.render()" class="chip">${s<60?fa(s)+'s':fa(s/60)+'m'}</button>`).join('')}
    </div>
  </div>

  <div class="card p-4 mt-3">
    <div class="flex items-center justify-between mb-2"><span class="text-xs text-mut">⭐ پریست‌های من</span>
      <button onclick="newPreset()" class="btn btn-g px-3 py-1 text-[11px]">+ جدید</button></div>
    <div class="grid grid-cols-2 gap-2">
     ${S.presets.map(p=>`<button onclick="runPreset('${p.id}')" class="card p-3 text-right active:scale-95">
       <div class="text-lg">${p.icon||'⏱️'}</div>
       <div class="font-bold text-[12px] mt-1">${esc(p.name)}</div>
       <div class="text-[10px] text-mut">${p.type==='interval'?`${fa(p.work)}s کار / ${fa(p.rest)}s استراحت × ${fa(p.rounds)}`:mmss(p.sec)}</div>
       <div onclick="event.stopPropagation();delPreset('${p.id}')" class="text-[10px] text-red-400 mt-1">حذف</div>
     </button>`).join('')}
    </div>
  </div>

  <div class="card p-4 mt-3">
    <div class="text-xs text-mut mb-2">🔥 اینتروال سریع (HIIT)</div>
    <div class="grid grid-cols-3 gap-2">
      <div><label class="text-[10px] text-mut">کار</label><input id="ivW" type="number" value="30" class="inp mt-1 text-center"></div>
      <div><label class="text-[10px] text-mut">استراحت</label><input id="ivR" type="number" value="15" class="inp mt-1 text-center"></div>
      <div><label class="text-[10px] text-mut">دور</label><input id="ivN" type="number" value="8" class="inp mt-1 text-center"></div>
    </div>
    <button onclick="Timer.startInterval({work:+ivW.value,rest:+ivR.value,rounds:+ivN.value})" class="btn btn-p w-full py-2.5 mt-2 text-sm">🚀 شروع اینتروال</button>
  </div>

  <button onclick="go('sounds')" class="btn btn-g w-full py-3 mt-3 text-sm">🔔 مدیریت صداها و زنگ‌ها</button>`;
  renderTimerFace();
}
function renderTimerFace(){
  const t=$('#tTime');if(!t)return;
  const pct=Timer.total?Timer.remain/Timer.total:0;
  t.textContent=mmss(Timer.remain);
  $('#tRing').style.strokeDashoffset=552.9*(1-pct);
  $('#tMain').textContent=Timer.running?'⏸ مکث':'▶ شروع';
  $('#tMain').classList.toggle('pulse-ring',Timer.running);
  $('#tLabel').textContent=Timer.mode==='interval'
    ?`اینتروال · دور ${fa(Timer.round)} از ${fa(Timer.interval?.rounds||0)}`:(Timer.label||'شمارش معکوس');
  $('#tSub').textContent=Timer.mode==='interval'?(Timer.phase==='work'?'💪 کار':'😮‍💨 استراحت'):(Timer.running?'در حال اجرا':'آماده');
}
function setFromInputs(){const s=(+$('#tMin').value||0)*60+(+$('#tSec').value||0);if(s<=0)return toast('زمان نامعتبر','⚠️');Timer.set(s);Timer.start()}
function runPreset(id){const p=S.presets.find(x=>x.id===id);if(!p)return;
  if(p.type==='interval')Timer.startInterval({work:p.work,rest:p.rest,rounds:p.rounds});
  else Timer.startCustom(p.sec,{label:p.name});}
function newPreset(){
  openSheet(`<h2 class="font-black mb-3">⭐ پریست جدید</h2>
   <input id="pN" class="inp mb-2" placeholder="اسم (مثلاً استراحت ددلیفت)">
   <div class="grid grid-cols-2 gap-2 mb-2">
     <input id="pS" type="number" class="inp" placeholder="ثانیه" value="90">
     <input id="pI" class="inp" placeholder="ایموجی" value="⏱️"></div>
   <button onclick="savePreset()" class="btn btn-p w-full py-3">ذخیره</button>`);
}
function savePreset(){S.presets.push({id:uid(),name:$('#pN').value||'پریست',sec:+$('#pS').value||60,icon:$('#pI').value||'⏱️'});save();closeSheet();renderTimer()}
function delPreset(id){S.presets=S.presets.filter(p=>p.id!==id);save();renderTimer()}

/* ==========================================================================
   ۱۵) صداها
   ========================================================================== */
const SND_EV=[['timer_end','🔔 پایان تایمر / استراحت'],['countdown','⏳ شمارش ۳-۲-۱'],['set_done','✅ اتمام ست'],
  ['start','▶️ شروع'],['pr','🏆 رکورد جدید'],['finish','🎉 پایان تمرین'],['warn','⚠️ هشدار مربی']];
async function renderSounds(){
  const all=await new Promise(res=>{if(!IDB)return res([]);const q=IDB.transaction('sounds').objectStore('sounds').getAll();q.onsuccess=()=>res(q.result||[])});
  window._snds=all;
  $('#app').innerHTML=`
  <button onclick="go('timer')" class="text-xs text-mut mb-2">‹ برگشت</button>
  <h1 class="text-xl font-black mb-1">🔔 صداها و زنگ‌ها</h1>
  <p class="text-xs text-mut mb-4">آهنگ یا زنگ دلخواه خودت رو آپلود کن و به هر رویداد وصل کن</p>
  <label class="btn btn-p w-full py-3 mb-4 cursor-pointer">⬆️ آپلود آهنگ / زنگ
    <input type="file" accept="audio/*" multiple class="hidden" onchange="upSound(this)"></label>
  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-2">🎵 کتابخانه (${fa(all.length)})</div>
    ${all.length?all.map(s=>`<div class="flex items-center gap-2 py-2 border-b border-white/5">
       <button onclick="Snd.playId('${s.id}')" class="btn btn-p w-9 h-9 text-xs">▶</button>
       <div class="flex-1 min-w-0"><div class="text-[13px] font-bold truncate">${esc(s.name)}</div>
         <div class="text-[10px] text-mut">${fa(Math.round(s.size/1024))} KB</div></div>
       <button onclick="Snd.stopAll()" class="btn btn-g w-9 h-9 text-xs">⏹</button>
       <button onclick="delSound('${s.id}')" class="btn btn-g w-9 h-9 text-xs">🗑</button></div>`).join('')
     :'<p class="text-xs text-mut text-center py-3">هنوز صدایی آپلود نکردی — از صداهای پیش‌فرض استفاده می‌شه</p>'}
  </div>
  <div class="card p-4">
    <div class="text-xs text-mut mb-3">🎯 تخصیص صدا به رویداد</div>
    ${SND_EV.map(([ev,t])=>`<div class="mb-3">
      <div class="flex items-center justify-between mb-1"><span class="text-[12px] font-bold">${t}</span>
        <button onclick="Snd.fire('${ev}')" class="chip !text-[10px]">تست ▶</button></div>
      <select class="inp !py-2 !text-[12px]" onchange="bindSound('${ev}',this.value)">
        <option value="">پیش‌فرض (بوق)</option>
        ${all.map(s=>`<option value="${s.id}" ${S.settings.bind[ev]===s.id?'selected':''}>${esc(s.name)}</option>`).join('')}
      </select></div>`).join('')}
  </div>
  <div class="card p-4 mt-3">
    <label class="flex items-center justify-between"><span class="text-sm font-bold">🗣️ صدای مربی (گفتار)</span>
      <input type="checkbox" ${S.settings.coach.voice?'checked':''} onchange="S.settings.coach.voice=this.checked;save()" class="w-5 h-5 accent-cyan-400"></label>
    <button onclick="Snd.speak('سلام قهرمان! من مربی تو هستم، بزن بریم')" class="btn btn-g w-full py-2 mt-2 text-xs">تست صدا 🔊</button>
  </div>`;
}
async function upSound(inp){
  for(const f of inp.files){await idbPut('sounds',{id:uid(),name:f.name.replace(/\.[^.]+$/,''),size:f.size,mime:f.type,blob:f})}
  inp.value='';toast('آپلود شد 🎵');renderSounds();
}
function bindSound(ev,id){S.settings.bind[ev]=id||null;save();if(id)Snd.playId(id)}
async function delSound(id){await idbDel('sounds',id);Object.keys(S.settings.bind).forEach(k=>{if(S.settings.bind[k]===id)S.settings.bind[k]=null});save();renderSounds()}

/* ==========================================================================
   ۱۶) جلسه‌ی زنده
   ========================================================================== */
function renderSession(){
  if(!Live.active)return go('home');
  const p=Live.plan,done=Live.doneSets(),tot=Live.totalSets();
  const min=Math.round((Date.now()-Live.started)/60000);
  $('#app').innerHTML=`
  <div class="card p-4 glow mb-3 sticky top-[62px] z-40">
    <div class="flex items-center justify-between">
      <div><div class="font-black">${esc(p.title)}</div>
        <div class="text-[11px] text-mut">⏱️ ${fa(min)}′ · ${fa(done)}/${fa(tot)} ست · ${fa(Math.round(Live.volume()))}kg</div></div>
      <button onclick="Live.finish()" class="btn btn-p px-4 py-2 text-xs">🏁 پایان</button>
    </div>
    <div class="bar mt-2"><i style="width:${tot?done/tot*100:0}%"></i></div>
  </div>
  ${p.ex.map((e,i)=>{
    const prev=lastPerf(e.exId),pr=bestOf(e.exId);
    return`<div class="card p-3 mb-3">
     <div class="flex items-center justify-between mb-2">
       <div><div class="font-black text-sm">${esc(e.name)} ${e.ss?`<span class="chip !text-[9px]">SS ${e.ss}</span>`:''}</div>
         <div class="text-[10px] text-mut">${prev?'قبلی: '+prev:'اولین بار'} ${pr?`· 🏆 ${fa(pr)}kg`:''}</div></div>
       <button onclick="showExInfo('${e.exId}')" class="btn btn-g w-8 h-8 text-xs">ℹ️</button>
     </div>
     ${e.sets.map((s,j)=>{const l=Live.log.find(x=>x.k===i+'_'+j);const dn=l&&l.done;
       return`<div class="setrow grid grid-cols-[26px_1fr_1fr_42px] gap-1.5 items-center mb-1.5 p-1.5 rounded-xl border border-white/5 ${dn?'done':''}">
        <div class="text-center text-[11px] font-bold ${s.type==='warmup'?'text-amber-400':''}">${s.type==='warmup'?'W':fa(j+1)}</div>
        <input id="r_${i}_${j}" class="inp !py-1.5 !text-[13px] text-center" value="${l?.r??s.reps}" placeholder="تکرار">
        <input id="w_${i}_${j}" type="number" step="0.5" class="inp !py-1.5 !text-[13px] text-center" value="${l?.w??s.w??''}" placeholder="وزن">
        <button onclick="tick(${i},${j})" class="btn ${dn?'btn-p':'btn-g'} h-9 text-sm">${dn?'✓':'○'}</button>
       </div>`}).join('')}
     <div class="flex gap-1 mt-1">
       <button onclick="Live.addSet(${i})" class="btn btn-g flex-1 py-1.5 text-[11px]">+ ست اضافه</button>
       <button onclick="Timer.startCustom(${e.rest||90},{label:'استراحت'})" class="btn btn-g flex-1 py-1.5 text-[11px]">⏱️ استراحت ${fa(e.rest||90)}s</button>
     </div>
    </div>`}).join('')}
  <button onclick="Live.finish()" class="btn btn-p w-full py-4 text-base mb-4">🏁 پایان تمرین</button>`;
}
function tick(i,j){
  const r=$('#r_'+i+'_'+j).value,w=$('#w_'+i+'_'+j).value;
  Live.toggleSet(i,j,r,w);
}
async function showExInfo(id){ viewEx(id) }

/* ==========================================================================
   ۱۷) آمار
   ========================================================================== */
function renderStats(){
  const ses=S.sessions,P=S.progress;
  const vol=ses.reduce((a,s)=>a+s.volume,0),sets=ses.reduce((a,s)=>a+s.sets,0);
  const weeks=[];for(let i=7;i>=0;i--){const st=Date.now()-i*7*864e5;
    const v=ses.filter(s=>s.ts>st-7*864e5&&s.ts<=st).reduce((a,s)=>a+s.volume,0);weeks.push(v)}
  const mx=Math.max(...weeks,1);
  const prs={};ses.forEach(s=>s.log.forEach(l=>{if(+l.w>(prs[l.name]||0))prs[l.name]=+l.w}));
  $('#app').innerHTML=`
  <h1 class="text-xl font-black mb-3">📊 آمار و پیشرفت</h1>
  <div class="grid grid-cols-2 gap-2 mb-3">
    ${stat('📆',fa(P.days),'روز تمرین')}${stat('🔥',fa(P.streak),'استریک')}
    ${stat('🏋️',fa(sets),'کل ست‌ها')}${stat('⚖️',fa(Math.round(vol/1000))+'t','حجم کل')}
    ${stat('⭐',fa(P.level),'سطح')}${stat('🏆',fa(P.longest),'رکورد استریک')}
  </div>
  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">📈 حجم تمرین (۸ هفته اخیر)</div>
    <div class="flex items-end gap-1.5 h-32">${weeks.map((v,i)=>`
      <div class="flex-1 flex flex-col items-center justify-end gap-1">
        <div class="w-full rounded-t-lg grad transition-all" style="height:${Math.max(4,v/mx*100)}%"></div>
        <div class="text-[8px] text-mut">${i===7?'این':fa(8-i)+'ه'}</div></div>`).join('')}</div>
  </div>
  ${Object.keys(prs).length?`<div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-2">🏆 رکوردهای شخصی</div>
    ${Object.entries(prs).sort((a,b)=>b[1]-a[1]).slice(0,10).map(([n,w])=>`
      <div class="flex justify-between py-1.5 border-b border-white/5 text-[13px]"><span>${esc(n)}</span><b class="text-acc">${fa(w)} kg</b></div>`).join('')}
  </div>`:''}
  <div class="card p-4">
    <div class="text-xs text-mut mb-2">📜 تاریخچه (${fa(ses.length)})</div>
    ${ses.length?ses.slice(0,20).map(s=>`
      <div class="flex items-center gap-3 py-2 border-b border-white/5">
        <div class="w-9 h-9 rounded-xl grad grid place-items-center text-xs">✓</div>
        <div class="flex-1"><div class="text-[13px] font-bold">${esc(s.title)}</div>
          <div class="text-[10px] text-mut">${faDate(new Date(s.ts))} · ${fa(s.sets)} ست · ${fa(Math.round(s.volume))}kg · ${fa(s.dur)}′</div></div>
      </div>`).join(''):'<p class="text-center text-xs text-mut py-4">هنوز تمرینی ثبت نشده</p>'}
  </div>`;
}

/* ==========================================================================
   ۱۸) عکس پیشرفت + یادداشت
   ========================================================================== */
function renderPhotos(){
  $('#app').innerHTML=`
  <div class="flex items-center justify-between mb-3">
    <h1 class="text-xl font-black">📸 عکس‌های پیشرفت</h1>
    <label class="btn btn-p px-4 py-2 text-sm cursor-pointer">+ افزودن
      <input type="file" accept="image/*" capture="environment" class="hidden" onchange="addPhoto(this)"></label></div>
  <div id="phGrid" class="grid grid-cols-2 gap-2"></div>
  ${!S.photos.length?'<div class="card p-8 text-center mt-2"><div class="text-5xl mb-2">📷</div><p class="text-sm text-mut">هر هفته یه عکس بگیر، پیشرفتت رو ببین!</p></div>':''}`;
  drawPhotos();
}
async function drawPhotos(){
  const g=$('#phGrid');if(!g)return;g.innerHTML='';
  for(const p of S.photos){const u=await mediaURL(p.mediaId);if(!u)continue;
    g.insertAdjacentHTML('beforeend',`<div class="card p-2">
      <img src="${u}" class="w-full aspect-[3/4] object-cover rounded-xl">
      <div class="text-[11px] mt-1 font-bold">${faDate(new Date(p.ts))}</div>
      <div class="text-[10px] text-mut">${p.weight?fa(p.weight)+' kg':''} ${esc(p.note||'')}</div>
      <button onclick="delPhoto('${p.id}')" class="text-[10px] text-red-400 mt-1">حذف</button></div>`)}
}
async function addPhoto(inp){
  const f=inp.files[0];if(!f)return;const id=await addMedia(f);
  const w=prompt('وزن امروز (کیلو) — اختیاری');
  S.photos.unshift({id:uid(),mediaId:id,ts:Date.now(),weight:w?+w:null,note:''});save();inp.value='';
  renderPhotos();Coach.say('عکس ثبت شد! چند هفته دیگه تفاوت رو می‌بینی 📸🔥',{anim:'cheer',badge:'📸',dur:4000});
}
function delPhoto(id){const p=S.photos.find(x=>x.id===id);if(p)idbDel('media',p.mediaId);
  S.photos=S.photos.filter(x=>x.id!==id);save();renderPhotos()}

function renderNotes(){
  $('#app').innerHTML=`
  <div class="flex items-center justify-between mb-3"><h1 class="text-xl font-black">📝 یادداشت‌ها</h1>
    <button onclick="addNote()" class="btn btn-p px-4 py-2 text-sm">+ جدید</button></div>
  ${S.notes.length?S.notes.map(n=>`<div class="card p-3 mb-2">
     <input class="inp !bg-transparent !border-0 !px-0 font-black" value="${esc(n.title)}" oninput="noteSet('${n.id}','title',this.value)">
     <textarea class="inp mt-1" rows="4" oninput="noteSet('${n.id}','body',this.value)">${esc(n.body)}</textarea>
     <div class="flex justify-between items-center mt-2">
       <span class="text-[10px] text-mut">${faDate(new Date(n.ts))}</span>
       <button onclick="delNote('${n.id}')" class="text-[11px] text-red-400">حذف</button></div>
   </div>`).join(''):'<div class="card p-8 text-center"><div class="text-5xl mb-2">📝</div><p class="text-sm text-mut">یادداشت تمرین، تغذیه، احساساتت...</p></div>'}`;
}
function addNote(){S.notes.unshift({id:uid(),title:'یادداشت جدید',body:'',ts:Date.now()});save();renderNotes()}
function noteSet(id,k,v){const n=S.notes.find(x=>x.id===id);n[k]=v;save()}
function delNote(id){S.notes=S.notes.filter(n=>n.id!==id);save();renderNotes()}

/* ==========================================================================
   ۱۹) تنظیمات
   ========================================================================== */
const THEMES=[['neon','نئون پالس','#00D4FF','#7C3AED'],['volcano','آتش‌فشان','#FF6B35','#EF4444'],
 ['arctic','یخ قطبی','#22D3EE','#94A3B8'],['ocean','اقیانوس شب','#14B8A6','#3B82F6'],
 ['gold','کربن طلایی','#F59E0B','#EAB308'],['toxic','سبز سمی','#39FF14','#84CC16'],
 ['violet','بنفش سلطنتی','#A78BFA','#D946EF'],['sunset','غروب وحشی','#FB7185','#F97316']];
function renderSettings(){
  const c=S.settings.coach;
  $('#app').innerHTML=`
  <h1 class="text-xl font-black mb-3">⚙️ تنظیمات</h1>

  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">🎨 تم رنگی</div>
    <div class="grid grid-cols-4 gap-2">
     ${THEMES.map(([id,n,a,b])=>`<button onclick="setTheme('${id}')" class="rounded-2xl p-2 border-2 ${S.settings.theme===id?'border-white/70':'border-transparent'}"
        style="background:linear-gradient(135deg,${a},${b})">
        <div class="h-7"></div><div class="text-[9px] font-bold text-white drop-shadow">${n}</div></button>`).join('')}
    </div>
    <label class="flex items-center justify-between mt-3 text-sm"><span>✨ انیمیشن پس‌زمینه</span>
      <input type="checkbox" ${S.settings.anim?'checked':''} onchange="S.settings.anim=this.checked;save();applyFx()" class="w-5 h-5 accent-cyan-400"></label>
    <label class="flex items-center justify-between mt-2 text-sm"><span>🫧 ذرات شناور</span>
      <input type="checkbox" ${S.settings.particles?'checked':''} onchange="S.settings.particles=this.checked;save();location.reload()" class="w-5 h-5 accent-cyan-400"></label>
  </div>

  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">🤖 مربی شخصی</div>
    <input class="inp mb-2" value="${esc(c.name)}" placeholder="اسم مربی" onchange="c_set('name',this.value)">
    <select class="inp mb-2" onchange="c_set('persona',this.value)">
      ${[['friendly','😊 رفیق صمیمی'],['tough','😤 سخت‌گیر'],['funny','😂 شوخ'],['pro','🧑‍🔬 حرفه‌ای'],['calm','🧘 آرام']]
        .map(([v,t])=>`<option value="${v}" ${c.persona===v?'selected':''}>${t}</option>`).join('')}</select>
    <select class="inp mb-2" onchange="c_set('chatty',this.value)">
      ${[['minimal','🔇 کم‌حرف'],['normal','💬 معمولی'],['chatty','📣 پرحرف']].map(([v,t])=>`<option value="${v}" ${c.chatty===v?'selected':''}>${t}</option>`).join('')}</select>
    <label class="flex items-center justify-between text-sm"><span>🗣️ صدای گفتار</span>
      <input type="checkbox" ${c.voice?'checked':''} onchange="c_set('voice',this.checked)" class="w-5 h-5 accent-cyan-400"></label>
    <label class="flex items-center justify-between text-sm mt-2"><span>🙈 مخفی کردن دستیار</span>
      <input type="checkbox" ${c.hidden?'checked':''} onchange="c_set('hidden',this.checked);$('#buddy').style.display=this.checked?'none':'block'" class="w-5 h-5 accent-cyan-400"></label>
    <button onclick="Coach.emit('open')" class="btn btn-g w-full py-2 mt-3 text-xs">تست مربی 🎤</button>
  </div>

  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">⏱️ تایمر</div>
    <label class="flex items-center justify-between text-sm mb-2"><span>شروع خودکار استراحت بعد هر ست</span>
      <input type="checkbox" ${S.settings.timer.autoRest?'checked':''} onchange="S.settings.timer.autoRest=this.checked;save()" class="w-5 h-5 accent-cyan-400"></label>
    <label class="flex items-center justify-between text-sm mb-2"><span>روشن نگه داشتن صفحه</span>
      <input type="checkbox" ${S.settings.timer.wake?'checked':''} onchange="S.settings.timer.wake=this.checked;save()" class="w-5 h-5 accent-cyan-400"></label>
    <div class="flex items-center justify-between text-sm"><span>استراحت پیش‌فرض (ثانیه)</span>
      <input type="number" class="inp !w-24 text-center" value="${S.settings.timer.defaultRest}" onchange="S.settings.timer.defaultRest=+this.value;save()"></div>
  </div>

  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">👤 پروفایل</div>
    <input class="inp mb-2" value="${esc(S.user.name)}" onchange="S.user.name=this.value;save();render()">
    <select class="inp" onchange="S.user.goal=this.value;save()">
      ${['حجم','کات / چربی‌سوزی','قدرت','تناسب اندام'].map(g=>`<option ${S.user.goal===g?'selected':''}>${g}</option>`).join('')}</select>
  </div>

  <div class="card p-4 mb-3">
    <div class="text-xs text-mut mb-3">💾 داده‌ها</div>
    <button onclick="exportData()" class="btn btn-g w-full py-2.5 mb-2 text-sm">⬇️ خروجی گرفتن (JSON)</button>
    <label class="btn btn-g w-full py-2.5 mb-2 text-sm cursor-pointer">⬆️ بازگردانی
      <input type="file" accept=".json" class="hidden" onchange="importData(this)"></label>
    <button onclick="go('sounds')" class="btn btn-g w-full py-2.5 mb-2 text-sm">🔔 صداها</button>
    <button onclick="if(confirm('همه‌چیز پاک شود؟')){localStorage.clear();indexedDB.deleteDatabase('gymbuddy');location.reload()}" class="btn w-full py-2.5 text-sm bg-red-500/20 text-red-300 border border-red-500/30">🗑 پاک کردن همه‌چیز</button>
  </div>
  <p class="text-center text-[10px] text-mut pb-4">ساخته شده با 💪 برای ${esc(S.user.name||'تو')}</p>`;
}
function c_set(k,v){S.settings.coach[k]=v;save()}
function setTheme(id){S.settings.theme=id;save();document.documentElement.dataset.theme=id;renderSettings();
  Coach.say('تم عوض شد! خوشگل شدی 😎',{anim:'cheer',badge:'🎨',dur:2600,voice:false})}
function applyFx(){document.body.classList.toggle('no-anim',!S.settings.anim)}
function exportData(){
  const b=new Blob([JSON.stringify(S,null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(b);
  a.download='gymbuddy-'+todayKey()+'.json';a.click();toast('خروجی گرفته شد','⬇️');
}
function importData(inp){
  const f=inp.files[0];if(!f)return;const r=new FileReader();
  r.onload=()=>{try{S=deepMerge(structuredClone(DEFAULT),JSON.parse(r.result));save();location.reload()}catch(e){toast('فایل نامعتبر','⚠️')}};
  r.readAsText(f);
}

/* ==========================================================================
   ۲۰) BOOT
   ========================================================================== */
(async function boot(){
  await idbOpen(); seed(); Prog.checkStreak();
  document.documentElement.dataset.theme=S.settings.theme;
  applyFx(); particles(); Coach.init();
  $('#hdStreak').textContent='🔥 '+fa(S.progress.streak);
  $('#hdSub').textContent=S.user.name?`روز ${fa(S.progress.days+1)}اُم · ${S.user.goal}`:'مربی شخصی تو';
  const h=location.hash.replace('#/','').split('/');
  VIEW=h[0]||'home'; PARAM=h[1]||null;
  if(['session'].includes(VIEW)&&!Live.active)VIEW='home';
  render();
  setInterval(()=>{ $('#hdStreak').textContent='🔥 '+fa(S.progress.streak); },30000);
  /* یادآور آب هر ۳۰ دقیقه حین حضور */
  setInterval(()=>{ if(!Live.active&&Math.random()<.35)Coach.emit('water') },30*60*1000);
})();
</script>
</body>
</html>
